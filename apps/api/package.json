{
  "name": "@xdm/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "start:worker": "nest build && node dist/worker-main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "db:migrate": "npm run typeorm -- migration:run",
    "db:generate": "npm run typeorm -- migration:generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/typeorm": "^12.0.3",
    "dotenv": "^18.0.3",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "oxlint": "^1.93.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
