DATABASE_URL=mysql://xdm:xdm@127.0.0.1:3306/xdm?allowPublicKeyRetrieval=true
PORT=3001
X_MODE=fake
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback
TOKEN_KEY=

# Keys: leave empty what you do not use. Models: empty = canned answers, no calls.
GOOGLE_API_KEY=
OPEN_ROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Text model (drafts, checks), e.g. gemini-4-hydrogen, claude-..., gpt-..., vendor/model on OpenRouter.
# claude, gpt and gemini names use their own key first, then OpenRouter; other names go to OpenRouter.
LLM_MODEL=
# Decision model: gemini-decision-1 (Google), typesafe/jev-1.14 or a decider on OpenRouter, or any text model (uncalibrated).
# Empty with LLM_MODEL set = the text model answers. Real X text goes to a provider only after its data policy is read.
DECISION_MODEL=
